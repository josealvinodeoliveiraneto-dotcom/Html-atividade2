    <title>Carros Sedan - Conforto e Espaço</title>
    <style>
        body { font-family: Georgia, serif; line-height: 1.6; margin: 0; padding: 20px; background-color: #fdfdfd; color: #222; }
        .container { max-width: 800px; margin: auto; background: #fff; padding: 30px; border-radius: 4px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        h1 { color: #1a237e; border-bottom: 2px solid #1a237e; padding-bottom: 10px; }
